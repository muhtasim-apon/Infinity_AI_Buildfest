erDiagram
  PROFILES ||--o{ FARMS : owns
  PROFILES ||--o{ SCANS : submits
  PROFILES ||--o{ CONSENTS : gives
  PROFILES ||--o| ALERT_PREFERENCES : sets
  FARMS ||--o{ FIELDS : contains
  CROPS ||--o{ FIELDS : planted_in
  CROPS ||--o{ DISEASE_CATALOG : affected_by
  FIELDS ||--o{ SCANS : located_in
  SCANS ||--o| DIAGNOSES : produces
  MODEL_VERSIONS ||--o{ DIAGNOSES : made_by
  DISEASE_CATALOG ||--o{ DIAGNOSES : predicted_as
  DIAGNOSES ||--o| ADVISORIES : explained_by
  ADVISORIES ||--o{ CITATIONS : cites
  KB_CHUNKS ||--o{ CITATIONS : referenced_by
  KB_DOCUMENTS ||--o{ KB_CHUNKS : split_into
  DISEASE_CATALOG ||--o{ ALERTS : about

  PROFILES {
    uuid id PK "= auth.users.id"
    text role "farmer|admin|demo"
    text display_name
    text locale "bn|en"
    text district
    text upazila
    timestamptz created_at
  }
  CONSENTS {
    uuid id PK
    uuid user_id FK
    text purpose "service|in_app_alerts"
    boolean granted
    text text_version
    timestamptz created_at
  }
  ALERT_PREFERENCES {
    uuid id PK
    uuid user_id FK "unique"
    boolean enabled
    real radius_km
  }
  FARMS {
    uuid id PK
    uuid owner_id FK
    text name
  }
  FIELDS {
    uuid id PK
    uuid farm_id FK
    int crop_id FK
    text variety
    date sowing_date
    numeric lat_coarse "2 decimals"
    numeric lon_coarse
  }
  CROPS {
    int id PK
    text code
    text name_bn
    text name_en
  }
  DISEASE_CATALOG {
    int id PK
    int crop_id FK
    text code
    text name_bn
    text pathogen_type
    boolean is_notifiable
  }
  SCANS {
    uuid id PK
    uuid user_id FK
    uuid field_id FK
    text storage_path "private bucket"
    char sha256 "unique per user"
    text status "pending_upload|uploaded|diagnosed|not_sure|failed"
    numeric lat_coarse
    numeric lon_coarse
    timestamptz created_at
  }
  DIAGNOSES {
    uuid id PK
    uuid scan_id FK "unique"
    uuid model_version_id FK
    int top1_disease_id FK
    real top1_prob
    jsonb top3
    boolean abstained
    text abstain_reason
    int latency_ms
  }
  MODEL_VERSIONS {
    uuid id PK
    text name
    text semver
    text architecture
    text onnx_sha256
    real threshold
    real temperature
    jsonb eval_summary
    boolean is_active
  }
  ADVISORIES {
    uuid id PK
    uuid diagnosis_id FK "unique"
    jsonb content
    text llm_model
    text status "ok|fallback|blocked"
  }
  CITATIONS {
    uuid id PK
    uuid advisory_id FK
    uuid chunk_id FK
    real score
  }
  KB_DOCUMENTS {
    uuid id PK
    text title
    text publisher
    text source_url
    text licence_note
    date edition_date
    timestamptz retired_at
  }
  KB_CHUNKS {
    uuid id PK
    uuid document_id FK
    int page
    text content
    vector embedding "384"
    jsonb meta
  }
  ALERTS {
    uuid id PK
    int disease_id FK
    numeric center_lat
    numeric center_lon
    real radius_km
    int report_count
    text risk "low|medium|high"
    text rule_version
    text status "published|dismissed"
    text dismiss_reason
    timestamptz created_at
  }
  APP_SETTINGS {
    text key PK
    jsonb value
    uuid updated_by
    timestamptz updated_at
  }
  AUDIT_LOG {
    bigint id PK
    uuid actor_id
    text action
    text entity
    jsonb detail "scrubbed"
    char prev_hash
    char row_hash
    timestamptz created_at
  }
