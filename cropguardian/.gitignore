# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
npm-debug.log*
.vite/

# Secrets - never commit
.env
.env.local
.env.production
*.pem
*.key
infra/nginx/certs/
runs/demos/accounts.txt
automation/n8n/credentials/*.json

# Datasets and ML artefacts - downloaded, never committed (licences, size)
data/raw/
data/processed/
ml/**/artifacts/
ml/**/checkpoints/
ml/data/
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors

# Knowledge-base raw/processed documents (licences: attribution only, no redistribution)
kb/raw/
kb/processed/

# Run outputs: keep summaries, ignore bulky/derived files
runs/gates/*.json
!runs/gates/.gitkeep
runs/demos/*
!runs/demos/readiness.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
.vercel

# Carried over from the template
ml/**/runs/
*.joblib
tests/**/reports/
playwright-report/
test-results/
k6-results/

# Local wheelhouse for TLS-intercepted networks (make wheelhouse)
backend/wheelhouse/
