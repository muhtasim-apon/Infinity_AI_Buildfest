# Crop Guardian — example environment. Copy to .env and fill. NEVER commit .env.
# On Render these live in an Environment Group named "cropguardian-secrets".

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development               # development | staging | production
LOG_LEVEL=info
APP_BASE_URL=http://localhost:5173    # frontend origin; also the only CORS origin allowed
API_BASE_URL=http://localhost:8000

# --- Supabase (Postgres + pgvector + Storage + Auth) ------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=                    # safe for the browser; RLS protects data
SUPABASE_SERVICE_ROLE_KEY=            # SERVER ONLY. Never ship to the frontend.
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:password@localhost:5432/cropguardian
DB_POOL_SIZE=5                        # small: Supabase free connection limits
STORAGE_BUCKET_SCANS=scans            # private bucket; access via signed URLs only
STORAGE_BUCKET_MODELS=models          # ONNX weights pulled at boot (Render disk is ephemeral)

# --- Vision model ------------------------------------------------------------
MODEL_NAME=crop-disease-classifier
MODEL_VERSION=v0.1.0
MODEL_PATH=/app/models/classifier.int8.onnx
MODEL_CONFIDENCE_THRESHOLD=0.70       # placeholder — set from calibration, docs/ai/statistics.md
MODEL_TEMPERATURE=1.0                 # set from temperature scaling on the validation split
INFERENCE_TIMEOUT_MS=4000
MAX_UPLOAD_MB=5

# --- LLM / RAG ----------------------------------------------------------------
LLM_PROVIDER=anthropic                # anthropic | google | openai — provider-swappable
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_MS=20000
EMBEDDING_MODEL=intfloat/multilingual-e5-small   # must handle Bangla
RAG_TOP_K=8
RAG_MIN_SCORE=0.55                    # below this: no advice, escalate

# --- Weather / outbreak -------------------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OUTBREAK_RADIUS_KM=5
OUTBREAK_MIN_REPORTS=3
OUTBREAK_WINDOW_DAYS=7

# --- Automation ---------------------------------------------------------------
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=                   # HMAC secret; API verifies every inbound webhook

# --- Security -----------------------------------------------------------------
RATE_LIMIT_SCANS_PER_HOUR=30
RATE_LIMIT_ADVISORY_PER_HOUR=60
AUDIT_HASH_SALT=

# --- Observability ------------------------------------------------------------
SENTRY_DSN=
