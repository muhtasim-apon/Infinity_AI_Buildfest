# Crop Guardian — environment variables (template). Copy to services/api/.env for local runs.
# NEVER commit .env. On Render, secrets are typed in the service's Environment tab
# (docs/deployment/01-render-guide.md §5). Web-app variables are listed at the end.

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development               # development | staging | production (production turns /docs off)
LOG_LEVEL=info
APP_BASE_URL=http://localhost:5173    # web app origin — the ONLY allowed CORS origin
API_BASE_URL=http://localhost:8000

# --- Supabase (Postgres + pgvector + Storage + Auth) ------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Keys: Dashboard → Settings → API Keys. Legacy anon/service_role keys are deprecated by end of 2026.
SUPABASE_SECRET_KEY=sb_secret_...            # SERVER ONLY. Bypasses RLS. Never in the frontend or repo.
# User tokens are verified with the project's JWKS (asymmetric signing keys), not a shared secret:
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Use the POOLER string from the dashboard's Connect button (IPv4). Direct db.<ref>.supabase.co is IPv6.
# Transaction pooler = port 6543 → asyncpg statement_cache_size=0; session pooler = 5432.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
DB_POOL_SIZE=5                        # small: free-tier connection limits
STORAGE_BUCKET_SCANS=scans            # private bucket; signed URLs only
STORAGE_BUCKET_MODELS=models          # private bucket; ONNX downloaded at boot (Render disk is ephemeral)

# --- Vision model ------------------------------------------------------------
MODEL_NAME=crop-disease-classifier
MODEL_PATH=/tmp/models/classifier.int8.onnx
INFERENCE_TIMEOUT_MS=4000
MAX_UPLOAD_MB=5
# τ (confidence threshold) and T (temperature) come from the active model_versions row /
# app_settings — set by calibration, changed only via /admin (audited).

# --- LLM / RAG ----------------------------------------------------------------
LLM_PROVIDER=anthropic                # provider-swappable
ANTHROPIC_API_KEY=                    # secret; spend cap set in the Anthropic Console
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_MS=20000
EMBEDDING_MODEL=intfloat/multilingual-e5-small   # Bangla-capable
RAG_TOP_K=8
RAG_MIN_SCORE=0.55                    # below this: no generated advice, static fallback card

# --- Outbreak alerts (rules v1; defaults, tunable in /admin) -------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OUTBREAK_RADIUS_KM=5
OUTBREAK_MIN_REPORTS=3
OUTBREAK_WINDOW_DAYS=7
OUTBREAK_COOLDOWN_HOURS=48

# --- Automation ---------------------------------------------------------------
N8N_WEBHOOK_SECRET=                   # secret; HMAC for webhooks in both directions
N8N_ALERT_WEBHOOK_URL=                # n8n workflow 01 production webhook URL

# --- Security -----------------------------------------------------------------
TURNSTILE_SECRET_KEY=                 # secret; Cloudflare Turnstile (demo-session CAPTCHA check)
RATE_LIMIT_SCANS_PER_HOUR=30
RATE_LIMIT_ADVISORY_PER_HOUR=60
RATE_LIMIT_DEMO_PER_MINUTE=10

# --- Observability ------------------------------------------------------------
SENTRY_DSN=

# --- Web app (apps/web/.env.local) — ALL PUBLIC, compiled into the JS bundle ---
# VITE_API_BASE_URL=http://localhost:8000
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_TURNSTILE_SITE_KEY=
