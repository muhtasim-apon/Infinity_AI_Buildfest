# RemitOS - example environment. Copy to .env and fill. NEVER commit .env.

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=info
DATA_RESIDENCY_REGION=bd-dhaka-1          # PII must not leave this region

# --- Datastores -------------------------------------------------------------
POSTGRES_DSN=postgresql://user:pass@localhost:5432/remitos
REDIS_URL=redis://localhost:6379/0
KAFKA_BROKERS=localhost:9092
VECTOR_DB_URL=http://localhost:6333        # Qdrant / pgvector endpoint
GRAPH_DB_URL=bolt://localhost:7687         # Neo4j - GraphRAG entity graph
OBJECT_STORE_ENDPOINT=http://localhost:9000

# --- LLM / AI ---------------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL_PRIMARY=claude-opus-5
LLM_MODEL_FAST=claude-haiku-4-5-20251001
EMBEDDING_MODEL=intfloat/multilingual-e5-large   # must handle Bangla
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_TOP_K=20
RAG_RERANK_TO=5
RAG_MIN_CITATION_SCORE=0.55

# --- Automation -------------------------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=

# --- Compliance -------------------------------------------------------------
SANCTIONS_LIST_SOURCES=OFAC,UN,EU,UK-HMT
TRAVEL_RULE_THRESHOLD_USD=1000
AML_HUMAN_REVIEW_SCORE=0.70               # above this a human must decide

# --- Regulatory constraints (Bangladesh Bank, re-fixed Mar 2025) ------------
BB_MFS_CASHOUT_DAILY_BDT=30000
BB_MFS_CASHOUT_MONTHLY_BDT=200000
BB_MFS_CASHIN_DAILY_BDT=50000
BB_MFS_P2P_DAILY_BDT=50000
BB_MFS_MAX_WALLET_BALANCE_BDT=500000

# --- Observability ----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=
